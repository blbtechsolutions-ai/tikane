# ============================================================
# TIKANE - Digital Tontine Platform
# Environment Variables Template
# ============================================================

# App
NODE_ENV=development
PORT=3000
APP_NAME=Tikane
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://tikane_user:tikane_password@localhost:5432/tikane_db

# JWT
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_here_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# AWS S3 (or compatible: MinIO, Cloudflare R2)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tikane-storage
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@tikane.ht
SMTP_PASS=your_smtp_password
EMAIL_FROM=Tikane <noreply@tikane.ht>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp (Meta API)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (for refresh token blacklist & rate limiting)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Payments (future)
MONCASH_CLIENT_ID=your_moncash_client_id
MONCASH_CLIENT_SECRET=your_moncash_client_secret
MONCASH_ENV=sandbox

NATCASH_API_KEY=your_natcash_api_key
NATCASH_ENV=sandbox

# Currency
DEFAULT_CURRENCY=HTG
