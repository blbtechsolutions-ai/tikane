FROM node:20-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY frontend/package*.json ./
RUN npm install --include=optional && npm cache clean --force

COPY frontend/ ./
RUN npx ng build --configuration production

FROM nginx:1.25-alpine AS production
ENV PORT=3000

RUN rm /etc/nginx/conf.d/default.conf

COPY frontend/nginx.frontend.conf /etc/nginx/templates/default.conf.template
COPY frontend/docker-entrypoint.d/10-runtime-env.sh /docker-entrypoint.d/10-runtime-env.sh
RUN chmod +x /docker-entrypoint.d/10-runtime-env.sh

COPY --from=builder /app/dist/tikane/browser /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
